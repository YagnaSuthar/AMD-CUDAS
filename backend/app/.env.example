# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cudas
DATABASE_ECHO=false

# ── Groq LLM ────────────────────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL_NAME=llama-3.1-8b-instant
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=1024

# ── Audio ─────────────────────────────────────────────────────────────
AUDIO_UPLOAD_DIR=storage/audio/uploads
AUDIO_OUTPUT_DIR=storage/audio/outputs

# ── Interview Defaults ────────────────────────────────────────────────
DEFAULT_DIFFICULTY=medium
MAX_QUESTIONS_PER_SESSION=15
VOICE_SILENCE_TIMEOUT=10
ANSWER_TIMEOUT=20

# ── JWT Authentication ────────────────────────────────────────────────
JWT_SECRET_KEY=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── SMTP Email ────────────────────────────────────────────────────────
SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# ── Static CUDAS Admin ────────────────────────────────────────────────
CUDAS_ADMIN_EMAIL=
CUDAS_ADMIN_PASSWORD=
